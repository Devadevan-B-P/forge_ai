# Core FastAPI Settings
FRONTEND_ORIGIN=http://localhost:5173

# Groq LLM settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# MongoDB Settings (MongoDB Atlas cloud connection string; localhost/127.0.0.1 are disabled by database.py)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.e99jtyl.mongodb.net
MONGODB_DB=forge_ai

# Redis Rate Limiter Settings (Optional, e.g. redis://localhost:6379/0)
REDIS_URL=

# Security Settings (Generate secure key with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
