# Python (Backend)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/venv/
**/.venv/
**/env/
**/ENV/
# Environment variables (exclude real env configurations at any level)
.env
.env.*
!backend/.env.example
!frontend/.env.example

# Node/React (Frontend)
**/node_modules/
**/dist/
**/*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lockfiles (we standardise on npm, so ignore other lockfiles)
yarn.lock
pnpm-lock.yaml
pnpm-workspace.yaml

# Databases
**/*.db
**/*.sqlite
**/*.sqlite3

# IDEs & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
